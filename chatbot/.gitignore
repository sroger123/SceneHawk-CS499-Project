# Large external datasets (do not redistribute)
data/external/
data/reviews.jsonl

# Labelling batches: these embed aclImdb review text, so they are not ours to
# redistribute. Regenerate them with scripts/05_sample_for_labeling.py - the
# seed is fixed, so everyone gets the same sample. The labels themselves go
# into Supabase, not git.
data/labeling/batch_*.csv
data/labeling/*.docx
!data/labeling/manifest.json

# The split files carry the full aclImdb review text (~5 MB), which is not ours
# to redistribute. The labels themselves are, so scripts/08_export_labels.py
# writes text-free copies to data/labels/ and those are committed instead.
data/learning.csv
data/checking.csv
data/exam.csv

# The training JSONL carries the full review text (same reason as
# reviews.jsonl). Regenerate with scripts/09_build_training_data.py.
# meta.json is the exception and IS committed: it holds the 28-feeling order
# that training, scoring and the database all have to agree on, plus the
# per-feeling positive counts the trainer weights its loss with. No review
# text, 1.6 KB, and eval/score.py cannot run without it - ignoring it left
# the scorer broken on a fresh clone. The dir/* form matters here, because
# git will not look inside an excluded directory to find a negation.
data/training/*
!data/training/meta.json

# Model predictions, regenerable in seconds from scripts/10_baseline.py.
# The tuned thresholds ARE committed - they must be frozen before scoring.
eval/preds/

# Copy this file to .env and fill in your own key.
#   cp .env.example .env      (or copy it in your file explorer)
# .env is gitignored, so your key stays private.

# TMDB key - used by scripts/02_build_starter.py to look up film details
# by IMDb ID. This is the only key the data pipeline needs.
TMDB_API_KEY=

# Supabase Postgres connection string - used by scripts/04_load_supabase.py.
# Supabase dashboard > Connect > "Connection pooling" > copy the URI, then
# replace [YOUR-PASSWORD] with your database password.
# This grants full read/write to the database. Never commit it, never put it
# in frontend code.
SUPABASE_DB_URL=

# Copy this file to .env.local for local dev, or set the same keys in the
# Vercel dashboard (Project > Settings > Environment Variables) for deploys.
# Everything here is OPTIONAL — the app runs with no keys, degrading to
# deterministic fallbacks (see AGENTS.md).

# --- Feelings search (the /chat page + /api/chat) ---
# Supabase project URL and its public "anon" key: Supabase dashboard >
# Project Settings > API. The anon key is safe to expose: with the search
# migration applied, it can only call match_films() and search_status(),
# never read or write the tables. Without these, /chat says it isn't connected.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=

# --- In-app comparison pipelines (/search), per AGENTS.md ---
# FILM_STORE=local        # local JSON corpus (default) | firestore
# RETRIEVER=bm25          # bm25 (default) | embedding (needs OPENAI_API_KEY)
# OPENAI_API_KEY=         # enables LLM interpretation/explanations + embeddings

# --- Site metadata ---
# Optional absolute site URL for Open Graph metadata. On Vercel it defaults
# to https://$VERCEL_PROJECT_PRODUCTION_URL.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
